// Kal — Prisma schema (foundation, Wave 1).
//
// Authority: Kal docs repo (../../) — PRD.md §21 (logical data model),
// ARCHITECTURE.md §4 (invariants I1–I15), §9 (module map), §11 (data & tenancy),
// ADR-0002 (narrow fail-closed RLS). This file carries ONLY the Wave-1
// foundation tables; domain tables land with their own waves as reviewed
// migrations (never via `prisma db push` — production auto-sync is forbidden).
//
// Conventions used here:
//   - Client fields are camelCase; every column is @map'ped to snake_case.
//   - Primary keys are server-generated UUIDs (gen_random_uuid(), PostgreSQL 13+).
//   - Timestamps are timestamptz (UTC instants; local-day boundaries are
//     computed in domain logic, Africa/Cairo default — ARCHITECTURE §16).
//   - Per-plane id columns are immutable UUIDs — consumers `user_id`, vendors
//     `vendor_id`, drivers `driver_user_id`, admins `admin_id` (I1; see README
//     "Roles & row-level security").
//   - Roles, GRANTs, and RLS policies ship as raw SQL inside migrations,
//     never as ad hoc scripts (ADR-0002 §4).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // ESM imports with explicit .ts extensions so the seed scaffold (and any
  // script) can run under Node's built-in TypeScript type stripping — no
  // extra tooling needed. Application code imports are unaffected.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Foundation (Wave 1 — this lane)
// ---------------------------------------------------------------------------

/// Platform-owned, append-only audit log of privileged actions
/// (ARCHITECTURE §15, I14: actor, action, target, timestamp, justification).
/// Not a consumer-health table — deliberately outside RLS scope (ADR-0002 §1).
/// Append-only is enforced structurally in the roles/RLS migration:
/// no UPDATE/DELETE grants for any role, plus a BEFORE UPDATE/DELETE trigger.
model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Privileged-plane actor identifier (admin actor; W1 has no admin tables
  /// yet, so this is an opaque identifier string, not a foreign key).
  actor String

  /// Stable, registered action code (e.g. a moderation or lifecycle action).
  action String

  /// Target reference as an opaque internal identifier (never user-facing PII).
  target String

  /// Why the privileged action was taken — mandatory (I14 / §15).
  justification String

  /// When the action happened (server clock, UTC). Set once at INSERT;
  /// rows are never updated (append-only, I14).
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@map("audit_events")
}

/// RLS pilot — consumer health table, one user's rows (ADR-0002 §2.1 "weight
/// logs"). Minimal Wave-1 shape per the s1 task contract; Wave 5 (goals)
/// extends this table FORWARD-ONLY (additional columns via new migrations; the
/// columns shipped here are never rewritten or repurposed).
///
/// Isolation (the point of the pilot):
///   - user_id is immutable (column-level UPDATE grant excludes it) and
///     NOT NULL; there is no consumer table yet (identity lands in W2), so
///     there is deliberately no foreign key — W2 must not add one here
///     retroactively unless it also ships the compound user-reference pattern
///     documented in README.
///   - Row-level security, fail-closed: a connection that has not set the
///     transaction-local `app.user_id` GUC sees ZERO rows, ever.
///     `kal_platform` has explicit per-table exemption policies (SELECT/DELETE
///     only) for the enumerated cross-user job shapes (ADR-0002 §3).
model WeightLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable consumer user id (I1 — per-plane id: consumers `user_id`).
  /// Never exposed as an authorization control by clients — the user binding
  /// is re-verified server-side (I6).
  userId String @map("user_id") @db.Uuid

  /// When the weigh-in happened (user's measurement instant, UTC).
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)

  /// Body weight in kilograms, two-decimal precision (PRD §21 "Weight log":
  /// timestamped weight entries per user, input to trend smoothing).
  weightKg Decimal @map("weight_kg") @db.Decimal(5, 2)

  /// W3 Stage-1 carryover (G2 evidence §6-E): the retroactive user FK the W1
  /// pilot deliberately omitted (no consumer table existed then). Plain FK —
  /// weight_log is an owned ROOT table with no children, so the compound
  /// (id, user_id) pattern has no structural target here; ON DELETE RESTRICT
  /// makes account deletion an explicit job that removes children itself.
  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
  @@map("weight_log")
}

// ---------------------------------------------------------------------------
// Identity (Wave 2 — lane w02-s1-schema; contract: docs/api/wave-02-contract.md)
// ---------------------------------------------------------------------------

/// Consumer account anchor (ARCHITECTURE §10/D-06, PRD §8). One row per
/// consumer identity. Not a consumer-health table — deliberately outside RLS
/// scope (ADR-0002 §1; the per-table adopt/decline decision for every W2
/// identity table is documented in docs/api/wave-02-contract.md §5 and the
/// README "Roles & row-level security" section).
///
/// Identifiers: all three sign-in identifiers are collected at signup (D-06)
/// and are UNIQUE at the database layer — enumeration resistance is an
/// application-layer observable (the signup duplicate path returns a generic
/// success; see the contract note §3), while uniqueness itself is structural.
/// Stored values are canonicalized by the application (email/username lower-
/// cased, phone E.164); the CHECK constraints pin the canonical shapes.
///
/// password is a PHC string (column named password per founder CR 2026-10-07; still a hash, never plaintext) (argon2id per ADR-0003) — never decoded,
/// never returned by any endpoint, never logged. It is NULL only for the
/// DEFERRED social-login path (Apple/Google — no such accounts exist in W2;
/// reserved seam per the contract note §4).
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Canonical lowercase email. Globally unique (structural uniqueness, I3).
  email String @unique @db.Text

  /// Canonical lowercase username, globally unique (PRD §8/D-06). Format
  /// pinned by CHECK `users_username_format` in the identity migration.
  username String @unique @db.Text

  /// Canonical E.164 phone. Nullable: W2 signup always provides it (D-06);
  /// NULL is reserved for the deferred social-login path, where the platform
  /// may not disclose a phone number. Unique where present (PostgreSQL allows
  /// multiple NULLs in a unique index).
  phone String? @unique @db.Text

  /// Salted adaptive hash (PHC string, argon2id — ADR-0003). NULL reserved
  /// for the deferred social-login path only. Never exposed, never logged.
  passwordHash String? @map("password") @db.Text

  /// Account lifecycle state (PRD §17). W2 only ever writes 'active'; the
  /// closure states are reserved structurally for the W6 lifecycle module.
  /// Sign-in refuses non-active accounts with the generic UNAUTHENTICATED
  /// observable (contract note §3 — closure never becomes an oracle).
  status String @default("active") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Touched on credential changes (rehash-on-login). Column-level UPDATE
  /// grants cover password and updated_at only — identity columns are
  /// immutable (I1).
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions              Session[]
  recoveryTickets       RecoveryTicket[]
  weightLogs            WeightLog[]
  userFoods             UserFood[]
  diaryEntries          DiaryEntry[]
  diaryDays             DiaryDay[]
  favorites             Favorite[]
  syncOperations        SyncOperation[]
  syncIdempotencyKeys   SyncIdempotencyKey[]
  userFoodCreateCounter UserFoodCreateCounter?

  @@map("users")
}

/// One row per signed-in session ("signed-in device", PRD §8/FR-007). Owned
/// child of users (I1/I3): immutable user_id FK, no UPDATE grant on the id or
/// user_id columns. The access JWT carries sid = this row's id; the refresh
/// token is an opaque secret whose SHA-256 hash lives on the row and ROTATES
/// on every use (rotation generation counter detects reuse ⇒ chain revocation
/// — contract note §1). Not a health table — RLS declined (contract note §5);
/// isolation via the identity module's mandatory user-scoped predicates.
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (per-plane id: consumers user_id, I1).
  userId String @map("user_id") @db.Uuid

  /// Optional client-chosen display label for "signed-in devices" lists
  /// (≤ 64 chars, CHECK-pinned). Never a device fingerprint: the abuse-
  /// throttle device key is a digested X-Device-Id header value that is
  /// never stored on sessions (contract note §2).
  deviceLabel String? @map("device_label") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Session expiry, sliding on refresh (founder CR 2026-10-07): each
  /// successful refresh re-arms expiresAt = now + sessionTtlSeconds — active
  /// users are never logged out by the timer; only full-TTL inactivity expires.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Set on explicit revocation or refresh-chain-reuse revocation.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// SHA-256 hex of the current opaque refresh token (rotates on use).
  refreshTokenHash String @unique @map("refresh_token_hash") @db.Text

  /// Increments on every refresh rotation; presenting a superseded
  /// generation revokes the chain (contract note §1).
  refreshGeneration Int @default(0) @map("refresh_generation") @db.Integer

  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  /// Sessions-list ordering key (contract note §2: createdAt DESC, id DESC —
  /// deterministic, reproducible pagination).
  @@index([userId, createdAt(sort: Desc)])
  @@map("sessions")
}

/// Single-use, bounded-TTL account-recovery ticket (PRD §8 recovery journeys;
/// FR-003). The ticket secret is issued once via the MailPort seam and only
/// its SHA-256 hash is stored; completion consumes the ticket transactionally
/// and invalidates ALL of the account's sessions. A new request invalidates
/// prior outstanding tickets (single live ticket per account — contract note
/// §2). Owned child of users (I1/I3). RLS declined (contract note §5).
model RecoveryTicket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1).
  userId String @map("user_id") @db.Uuid

  /// SHA-256 hex of the single-use ticket secret — never the secret itself.
  tokenHash String @unique @map("token_hash") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Bounded TTL (config point, contract note §6); expiry is a generic
  /// failure observable identical to wrong/used tickets.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Set transactionally at completion (single use). Expired tickets are
  /// cleaned up by the platform housekeeping shape (enumerated grant).
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("recovery_tickets")
}

/// Platform-owned credential-attempt throttle state (PRD §8 abuse prevention;
/// ARCHITECTURE §11 places rate-limit counters on the platform plane). Keyed
/// by DIGESTS of the submitted identifier and the device identifier — never
/// by user_id (counters must tick for unknown identifiers too, so the lockout
/// observable cannot become an existence oracle; contract note §3). Not
/// user-owned data at all — outside RLS scope entirely (declined, contract
/// note §5).
model AuthAttemptCounter {
  /// Server-keyed digest of the canonicalized submitted identifier.
  subjectKey String @map("subject_key") @db.Text

  /// Server-keyed digest of the client X-Device-Id header value.
  deviceKey String @map("device_key") @db.Text

  failedCount Int @default(0) @map("failed_count") @db.Integer

  firstFailedAt DateTime @default(now()) @map("first_failed_at") @db.Timestamptz(6)
  lastFailedAt  DateTime @default(now()) @map("last_failed_at") @db.Timestamptz(6)

  /// Set while the (identifier, device) pair is locked; NULL otherwise.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  @@id([subjectKey, deviceKey])
  @@map("auth_attempt_counters")
}

/// Platform-owned recovery-request throttle state (W3 Stage-1 carryover
/// F-S4-1 — G2 evidence §6-B/E, ledger §7-E4: the recovery-request surface
/// was accepted at G2 as unthrottled with a W3 config-point throttle). Same
/// digest-keyed shape as auth_attempt_counters: keyed by SERVER-KEYED
/// DIGESTS of the submitted identifier and the X-Device-Id header — never by
/// user_id (counters tick regardless of identifier existence, so the
/// throttle cannot become an existence oracle). Platform abuse-control
/// state, not user-owned data — RLS DECLINED (contract note §5).
/// Counts RECOVERY REQUESTS (a volume cap on ticket issuance/supersession),
/// fully separate from the credential-failure lockout rows above: two abuse
/// domains must never write each other's state.
model RecoveryRequestCounter {
  /// Server-keyed digest of the canonicalized submitted identifier.
  subjectKey String @map("subject_key") @db.Text

  /// Server-keyed digest of the client X-Device-Id header value.
  deviceKey String @map("device_key") @db.Text

  /// Requests counted inside the current window (resets when the window or
  /// lock expires — the auth_attempt_counters fresh-window semantics).
  requestCount Int @default(0) @map("request_count") @db.Integer

  /// Start of the current counting window.
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)

  /// Set when the window count crosses the configured threshold; NULL
  /// otherwise. While set, every request on the pair is rejected 429.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  @@id([subjectKey, deviceKey])
  @@map("recovery_request_counters")
}

// ---------------------------------------------------------------------------
// Tracking & sync (Wave 3 — lane w03-s1-schema; contract:
// docs/api/wave-03-contract.md). Platform catalog tables (foods, serving
// variants, barcode product cache) are NOT user-scoped — RLS DECLINED
// (per-table rationale in the contract note §5). User-owned health tables
// (user_foods + servings; diary entries/days + favorites in the next section;
// the sync op ledger mirrors diary payloads) ADOPT the fail-closed
// `app.user_id` RLS policy exactly per the weight_log pilot pattern.
// Per-table decisions are documented, never implied (ADR-0002).
// ---------------------------------------------------------------------------

/// Platform food catalog (PRD §21 "Food item", FR-010/FR-011). One row per
/// curated/imported food. NOT a consumer-health table and NOT user-scoped:
/// every authenticated consumer reads the same governed catalog — RLS is
/// DECLINED (contract note §5); isolation is irrelevant to row filtering here
/// (there is no user_id column at all).
///
/// `licensePartition` keeps Open Food Facts (ODbL) rows in an explicit
/// license-separated partition from proprietary (Kal-reviewed) rows
/// (ARCHITECTURE §19). Provenance tiers are FR-011's data basis
/// (kal_reviewed | imported | vendor_declared — the vendor tier is Phase 3
/// reserved; user-created foods live in UserFood, never here).
///
/// Search is served from the STORED normalized forms (name_en_normalized /
/// name_ar_normalized / aliases_normalized), written by the owning write path
/// using exactly the frozen normalization pipeline (contract note §7) — the
/// query is normalized once and matched against these columns; the database
/// never re-derives normalized forms.
model Food {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Catalog type (PRD §21). CHECK-pinned in the migration:
  /// dish | staple | packaged | recipe. `vendor_meal` is the Phase 3 reserved
  /// boundary (ARCHITECTURE §23 — added only by a future migration);
  /// `user_custom` never appears here (that is UserFood).
  type String @db.Text

  /// Provenance tier displayed at selection time (FR-011). CHECK-pinned:
  /// kal_reviewed | imported | vendor_declared.
  provenance String @db.Text

  /// License partition (§19): proprietary (Kal's own) | odbl (Open Food
  /// Facts import — attribution obligations travel with the row).
  licensePartition String @map("license_partition") @db.Text

  /// Display names (English required — consumer UI is EN-first; Arabic is
  /// the co-equal search target). Raw forms as authored; the normalized
  /// columns below are the frozen-pipeline projections.
  nameEn           String  @map("name_en") @db.Text
  nameAr           String? @map("name_ar") @db.Text
  nameEnNormalized String  @map("name_en_normalized") @db.Text
  nameArNormalized String? @map("name_ar_normalized") @db.Text

  /// Dialect/transliteration aliases (raw + normalized), e.g. taameya for
  /// طعمية. Matched by the same frozen matching model (note §7).
  aliases           String[]
  aliasesNormalized String[] @map("aliases_normalized")

  /// EAN/UPC barcode where the food is a packaged product (unique where
  /// present — the platform product cache resolves into this row).
  barcode String? @unique @db.Text

  /// Per-100 g nutrition (HD-12: values verified in-house; platform rows in
  /// W3 are engineering-initial pending founder nutrition review — contract
  /// note §8). Grams carry 3 decimals, energy 2.
  energyKcal Decimal @map("energy_kcal") @db.Decimal(9, 2)
  proteinG   Decimal @map("protein_g") @db.Decimal(9, 3)
  carbsG     Decimal @map("carbs_g") @db.Decimal(9, 3)
  fatG       Decimal @map("fat_g") @db.Decimal(9, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  servingVariants     ServingVariant[]
  barcodeCacheEntries BarcodeProductCache[]
  diaryEntries        DiaryEntry[]
  favorites           Favorite[]

  @@index([nameArNormalized])
  @@index([nameEnNormalized])
  @@map("foods")
}

/// Portion descriptor with gram weight for a platform food (PRD §21
/// "Serving variant", FR-012: the chosen serving variant must resolve to a
/// gram weight). Platform-owned catalog child — RLS DECLINED (parent foods
/// declined; not user-scoped data).
model ServingVariant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  foodId String @map("food_id") @db.Uuid

  /// Display labels (EN required, AR co-equal — bilingual from first commit
  /// applies to data served to the UI as well).
  labelEn String  @map("label_en") @db.Text
  labelAr String? @map("label_ar") @db.Text

  /// Gram weight of one unit of this variant (the FR-012 resolution target).
  grams Decimal @map("grams") @db.Decimal(9, 3)

  /// The portion sheet's preselected variant (one per food, CHECK-pinned
  /// in the migration via a partial unique index).
  isDefault Boolean @default(false) @map("is_default")

  food Food @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@map("serving_variants")
}

/// Platform barcode-resolution cache (FR-017 pipeline step 2: local client
/// cache → THIS platform product cache → Open Food Facts seam → guided
/// label-create). Platform-owned, not user-scoped — RLS DECLINED. Rows are
/// written once per barcode (first resolution wins; `ON CONFLICT DO NOTHING`)
/// and carry the adapter's normalized snapshot plus the resolved catalog row
/// when the barcode maps onto a packaged `foods` row.
model BarcodeProductCache {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The scanned EAN/UPC string (digits; CHECK-pinned 8–14 chars).
  barcode String @unique @db.Text

  /// Which seam resolved it: `open_food_facts` (the plan-named source behind
  /// its adapter seam — attribution rides in payload) or `platform`.
  source String @db.Text

  /// Resolved catalog food when the barcode maps onto a `foods` row.
  foodId String? @map("food_id") @db.Uuid

  /// Adapter snapshot (attribution + normalized nutrition fields). Never a
  /// raw provider response dump; contains no user data.
  payload Json?

  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  /// RESTRICT (never SET NULL): platform foods are not deleted in W3, and if
  /// deletion ever becomes a job it must resolve its cache children itself
  /// (contract: FKs ON DELETE RESTRICT everywhere).
  food Food? @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@map("barcode_product_cache")
}

/// User-created custom food (FR-017 guided label-create; PRD §21 "user
/// custom" type). Consumer-owned HEALTH table — RLS ADOPTED, fail-closed
/// (`app.user_id` policy, weight_log pilot pattern).
///
/// The `id` is the client-generated entity id (offline creation, ADR-0004):
/// stable IDs enable dedupe only — the user binding is re-verified on every
/// sync replay (I6). Tombstones are soft (`deletedAt`); a deleted id is never
/// resurrected (no-resurrection rule, contract note §1).
model UserFood {
  /// Client-generated entity id (UUID) — the sync op's entityId.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1). No UPDATE grant; compound-FK target
  /// for children via @@unique([id, userId]) (I3).
  userId String @map("user_id") @db.Uuid

  /// Display names — at least one of the two (CHECK-pinned).
  nameEn           String? @map("name_en") @db.Text
  nameAr           String? @map("name_ar") @db.Text
  nameEnNormalized String? @map("name_en_normalized") @db.Text
  nameArNormalized String? @map("name_ar_normalized") @db.Text

  /// Per-100 g nutrition as entered/verified by the user (label-create
  /// guided flow). Provenance is fixed `user_created` (FR-011) — enforced by
  /// the write path; no column, so it can never drift.
  energyKcal Decimal @map("energy_kcal") @db.Decimal(9, 2)
  proteinG   Decimal @map("protein_g") @db.Decimal(9, 3)
  carbsG     Decimal @map("carbs_g") @db.Decimal(9, 3)
  fatG       Decimal @map("fat_g") @db.Decimal(9, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Client-authored LWW timestamp (the winning op's clientUpdatedAt) — the
  /// last-write-wins substrate, NOT server clock (contract note §1).
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// Tombstone (soft delete; ADR-0004). Set by delete ops; never cleared —
  /// a fresh entity id after a delete is a NEW food (note §1).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// The client op id whose application last won this row (the LWW
  /// deterministic tiebreak comparator). NULL for REST-created rows — any
  /// sync op then wins (note §1).
  lastOpId String? @map("last_op_id") @db.Uuid

  user         User              @relation(fields: [userId], references: [id])
  servings     UserFoodServing[]
  diaryEntries DiaryEntry[]
  favorites    Favorite[]

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@map("user_foods")
}

/// Serving variant of a user-created food (portion descriptor with gram
/// weight). Consumer-owned health child — RLS ADOPTED. The compound user
/// reference (I3): (user_food_id, user_id) → user_foods(id, user_id) makes a
/// cross-account serving variant structurally impossible.
model UserFoodServing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userFoodId String @map("user_food_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  labelEn String? @map("label_en") @db.Text
  labelAr String? @map("label_ar") @db.Text
  grams   Decimal @map("grams") @db.Decimal(9, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Soft-deleted when an update op replaces the serving set.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// Compound user reference (I3) — never crosses accounts, structurally.
  userFood UserFood @relation(fields: [userFoodId, userId], references: [id, userId])

  @@index([userFoodId])
  @@map("user_food_servings")
}

/// Per-account user-food creation volume (the PRD §8 rate-limit substrate:
/// ≤20/hour, ≤100/day — config points, shared by the REST and sync-apply
/// paths). Platform-owned abuse-control state (ARCHITECTURE §11 places
/// rate-limit counters on the platform plane) — RLS DECLINED: it is not
/// user-owned data (the account has no self-service interest in its own
/// abuse counters; only the owning account's context can ever touch its
/// row). Rolling windows; one row per account.
model UserFoodCreateCounter {
  /// The counted account (the limiter only ever runs for an authenticated
  /// context — no digest indirection needed, unlike auth_attempt_counters).
  userId String @id @map("user_id") @db.Uuid

  /// Rolling hour window (start of the window = first tick in it) + count.
  hourWindowStart DateTime @map("hour_window_start") @db.Timestamptz(6)
  hourCount       Int      @default(0) @map("hour_count") @db.Integer

  /// Rolling 24 h window + count.
  dayWindowStart DateTime @map("day_window_start") @db.Timestamptz(6)
  dayCount       Int      @default(0) @map("day_count") @db.Integer

  user User @relation(fields: [userId], references: [id])

  @@map("user_food_create_counters")
}

// ---------------------------------------------------------------------------
// Diary & sync (Wave 3 — lane w03-s1-schema; contract:
// docs/api/wave-03-contract.md). ALL consumer-owned health tables here ADOPT
// the fail-closed `app.user_id` RLS policy (weight_log pilot pattern);
// `sync_idempotency_keys` is the one DECLINE (metadata only — rationale in
// the contract note §5). Diary mutations exist ONLY as sync operations —
// there is no diary REST mutation surface by design (note §1).
// ---------------------------------------------------------------------------

/// One diary entry (PRD §21, FR-012, I11). Created exclusively by sync
/// ingestion — the `id` is the client-generated entity id (offline creation;
/// dedupe only, never authorization — I6). The nutrient snapshot (macros +
/// resolved serving gram weight + quantity) is FROZEN at log time: later
/// catalog corrections never rewrite logged history (I11). The client-local
/// diary date (`local_date`) is carried in the op and is authoritative — the
/// server NEVER re-derives the day from receive/sync time (day-boundary rule,
/// note §1; 23:59 log / 00:01 sync stays on the original local day).
model DiaryEntry {
  /// Client-generated entity id (UUID) — the sync op's entityId.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1); compound-FK target via
  /// @@unique([id, userId]) (I3 — no W3 child references it yet; the
  /// pattern stands ready).
  userId String @map("user_id") @db.Uuid

  /// Client-local diary date (YYYY-MM-DD semantics via DATE column). The
  /// authoritative day — never derived server-side.
  localDate DateTime @map("local_date") @db.Date

  /// Meal slot: breakfast | lunch | dinner | snack (CHECK-pinned; Ramadan
  /// slots deliberately absent — HD-17, deferred beyond launch).
  mealSlot String @map("meal_slot") @db.Text

  /// How the entry was logged: search | recents | favorites |
  /// copy_yesterday | quick_add | barcode (CHECK-pinned).
  entryMethod String @map("entry_method") @db.Text

  /// Log source — exactly one of: platform food, user food, or quick-add
  /// (bare kcal/macros; no food reference). CHECK-pinned XOR in the
  /// migration. The user-food side carries the compound user reference (I3).
  foodId     String? @map("food_id") @db.Uuid
  userFoodId String? @map("user_food_id") @db.Uuid

  /// Frozen-at-log-time snapshot (I11). `quantity` × `servingGramWeight`
  /// reconstructs the logged amount; macros are the values used at log time
  /// — never retroactively rewritten by catalog edits. quick-add entries
  /// carry NULL serving fields (CHECK-pinned) and the bare macros.
  quantity          Decimal  @map("quantity") @db.Decimal(9, 3)
  servingLabelEn    String?  @map("serving_label_en") @db.Text
  servingLabelAr    String?  @map("serving_label_ar") @db.Text
  servingGramWeight Decimal? @map("serving_gram_weight") @db.Decimal(9, 3)
  energyKcal        Decimal  @map("energy_kcal") @db.Decimal(9, 2)
  proteinG          Decimal  @map("protein_g") @db.Decimal(9, 3)
  carbsG            Decimal  @map("carbs_g") @db.Decimal(9, 3)
  fatG              Decimal  @map("fat_g") @db.Decimal(9, 3)

  /// confirmed | edited (CHECK-pinned). `pending_order` is the Phase 3
  /// reserved boundary (FR-014 — added only by a future migration).
  status String @default("confirmed") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Client-authored LWW timestamp (winning op's clientUpdatedAt).
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// Tombstone (soft delete). Set by delete ops; never cleared.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// Winning op id — the LWW deterministic tiebreak comparator.
  lastOpId String? @map("last_op_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id])
  food     Food?     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  userFood UserFood? @relation(fields: [userFoodId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, localDate])
  @@index([userId, updatedAt])
  @@map("diary_entries")
}

/// Cached per-day rollups (PRD §21 "Diary day"). Computed by the diary
/// handlers from the user's own entries; the W5 goals lane joins the target
/// snapshot for that day's comparison (W3 shows totals only — ledger §7-E3).
/// Consumer-owned health table — RLS ADOPTED.
model DiaryDay {
  /// Immutable owning-consumer id (I1) — composite PK part.
  userId String @map("user_id") @db.Uuid

  /// The client-local diary date (composite PK part; same day-boundary rule
  /// as entries — never derived server-side).
  localDate DateTime @map("local_date") @db.Date

  /// Cached rollups over that day's non-deleted entries.
  energyKcal Decimal @default(0) @map("energy_kcal") @db.Decimal(12, 2)
  proteinG   Decimal @default(0) @map("protein_g") @db.Decimal(12, 3)
  carbsG     Decimal @default(0) @map("carbs_g") @db.Decimal(12, 3)
  fatG       Decimal @default(0) @map("fat_g") @db.Decimal(12, 3)
  entryCount Int     @default(0) @map("entry_count") @db.Integer

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, localDate])
  @@map("diary_days")
}

/// A favorited loggable food (quick re-log; FR-018). Consumer-owned health
/// table — RLS ADOPTED. Exactly one target: a platform food OR the user's
/// own food (CHECK-pinned XOR; the user-food side carries the compound user
/// reference, I3). Favorites are created/removed exclusively via sync ops.
model Favorite {
  /// Client-generated entity id (UUID) — the sync op's entityId.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1).
  userId String @map("user_id") @db.Uuid

  foodId     String? @map("food_id") @db.Uuid
  userFoodId String? @map("user_food_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Client-authored LWW timestamp (winning op's clientUpdatedAt).
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// Tombstone (soft delete; never cleared — a re-favorite is a NEW entity
  /// id; the partial uniqueness below applies to ACTIVE rows only).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// Winning op id — the LWW deterministic tiebreak comparator.
  lastOpId String? @map("last_op_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id])
  food     Food?     @relation(fields: [foodId], references: [id], onDelete: Restrict)
  userFood UserFood? @relation(fields: [userFoodId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@map("favorites")
}

/// The server-side sync operation ledger (PRD §21 "Sync operation";
/// ARCHITECTURE §12). One row per INGESTED operation keyed by the unique
/// pair (user_id, client_op_id) — the dedupe key (I9): replays are detected
/// and acknowledged, never re-applied; B replaying A's op id never matches
/// (the user binding is part of the key and re-verified — I6).
///
/// RLS ADOPTED: `payload` mirrors diary/user-food entity content — a leak is
/// exactly as catastrophic as the entity tables themselves (ADR-0002 scope:
/// "the tables where a leak is catastrophic"); a context-less or wrong-GUC
/// query sees zero rows. Platform retention/exemption policies ship WITH the
/// first enumerated platform job — none exists in W3 (ledger §6), so no
/// platform grants/policies land this wave (grants without policies would be
/// inert noise).
model SyncOperation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1) — part of the dedupe key.
  userId String @map("user_id") @db.Uuid

  /// Stable client-generated operation id (UUID) — dedupe only (I6).
  clientOpId String @map("client_op_id") @db.Uuid

  /// The pushing device's stable, client-generated opaque identifier
  /// (≤ 128 chars, CHECK-pinned). Ordering metadata, never a credential.
  deviceId String @map("device_id") @db.Text

  /// Entity-kind registry (frozen, note §1): diary_entry | user_food |
  /// favorite. CHECK-pinned.
  entityKind String @map("entity_kind") @db.Text

  /// create | update | delete (CHECK-pinned).
  entityAction String @map("entity_action") @db.Text

  /// The target entity's client-generated id.
  entityId String @map("entity_id") @db.Uuid

  /// Client-local diary date — REQUIRED on diary_entry ops, ABSENT otherwise
  /// (CHECK-pinned). The day-boundary rule rides here (note §1).
  localDate DateTime? @map("local_date") @db.Date

  /// Client-authored LWW timestamp (ISO 8601 UTC instants only).
  clientUpdatedAt DateTime @map("client_updated_at") @db.Timestamptz(6)

  /// Full entity snapshot for create/update; NULL for delete (CHECK-pinned
  /// parity). The ack envelope NEVER echoes payloads (note §1).
  payload Json?

  /// Recorded outcome: applied | rejected (CHECK-pinned). `duplicate` is the
  /// REPLAY outcome of an applied row — derived, never stored.
  outcome String @db.Text

  /// For rejected ops: the frozen per-op rejection code (note §1):
  /// rejected_validation | rejected_rate_limited | rejected_conflict |
  /// rejected_deleted. Present iff outcome = rejected (CHECK-pinned).
  rejectionCode String? @map("rejection_code") @db.Text

  /// Present iff outcome = rejected (CHECK-pinned): whether the client may
  /// retry the op unchanged after a delay (only `rejected_rate_limited` is
  /// retryable).
  retryable Boolean?

  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  /// The dedupe key (I9) — replays never re-apply.
  @@unique([userId, clientOpId])
  @@index([userId, entityKind, entityId])
  @@map("sync_operations")
}

/// Batch-level `Idempotency-Key` records (conventions §3: required on sync
/// ingestion; same key + same payload replays the recorded response; same key
/// + different payload ⇒ 409 CONFLICT). Owned child of users (I1), but the
/// content is METADATA ONLY (request digest + the recorded ack envelope —
/// acks never carry entity payloads), so it is not a health table: RLS
/// DECLINED, same I1–I3 posture as sessions (contract note §5).
model SyncIdempotencyKey {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1); part of the uniqueness key.
  userId String @map("user_id") @db.Uuid

  /// The endpoint the key scopes to (conventions §3: (user, endpoint, key)).
  endpoint String @db.Text

  /// Client-generated UUID (conventions §3 header value; UUID column).
  idempotencyKey String @map("idempotency_key") @db.Uuid

  /// SHA-256 hex of the canonical request body — the changed-payload
  /// detector (same key + different digest ⇒ 409 CONFLICT).
  requestDigest String @map("request_digest") @db.Text

  /// The recorded original outcome (status + ack envelope body) — replayed
  /// byte-identically while the key is retained.
  responseStatus Int  @map("response_status") @db.Integer
  responseBody   Json @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint, idempotencyKey])
  @@index([userId, createdAt])
  @@map("sync_idempotency_keys")
}

