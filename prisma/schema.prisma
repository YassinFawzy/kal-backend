// Kal — Prisma schema (foundation, Wave 1).
//
// Authority: Kal docs repo (../../) — PRD.md §21 (logical data model),
// ARCHITECTURE.md §4 (invariants I1–I15), §9 (module map), §11 (data & tenancy),
// ADR-0002 (narrow fail-closed RLS). This file carries ONLY the Wave-1
// foundation tables; domain tables land with their own waves as reviewed
// migrations (never via `prisma db push` — production auto-sync is forbidden).
//
// Conventions used here:
//   - Client fields are camelCase; every column is @map'ped to snake_case.
//   - Primary keys are server-generated UUIDs (gen_random_uuid(), PostgreSQL 13+).
//   - Timestamps are timestamptz (UTC instants; local-day boundaries are
//     computed in domain logic, Africa/Cairo default — ARCHITECTURE §16).
//   - Per-plane id columns are immutable UUIDs — consumers `user_id`, vendors
//     `vendor_id`, drivers `driver_user_id`, admins `admin_id` (I1; see README
//     "Roles & row-level security").
//   - Roles, GRANTs, and RLS policies ship as raw SQL inside migrations,
//     never as ad hoc scripts (ADR-0002 §4).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // ESM imports with explicit .ts extensions so the seed scaffold (and any
  // script) can run under Node's built-in TypeScript type stripping — no
  // extra tooling needed. Application code imports are unaffected.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Foundation (Wave 1 — this lane)
// ---------------------------------------------------------------------------

/// Platform-owned, append-only audit log of privileged actions
/// (ARCHITECTURE §15, I14: actor, action, target, timestamp, justification).
/// Not a consumer-health table — deliberately outside RLS scope (ADR-0002 §1).
/// Append-only is enforced structurally in the roles/RLS migration:
/// no UPDATE/DELETE grants for any role, plus a BEFORE UPDATE/DELETE trigger.
model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Privileged-plane actor identifier (admin actor; W1 has no admin tables
  /// yet, so this is an opaque identifier string, not a foreign key).
  actor String

  /// Stable, registered action code (e.g. a moderation or lifecycle action).
  action String

  /// Target reference as an opaque internal identifier (never user-facing PII).
  target String

  /// Why the privileged action was taken — mandatory (I14 / §15).
  justification String

  /// When the action happened (server clock, UTC). Set once at INSERT;
  /// rows are never updated (append-only, I14).
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@map("audit_events")
}

/// RLS pilot — consumer health table, one user's rows (ADR-0002 §2.1 "weight
/// logs"). Minimal Wave-1 shape per the s1 task contract; Wave 5 (goals)
/// extends this table FORWARD-ONLY (additional columns via new migrations; the
/// columns shipped here are never rewritten or repurposed).
///
/// Isolation (the point of the pilot):
///   - user_id is immutable (column-level UPDATE grant excludes it) and
///     NOT NULL; there is no consumer table yet (identity lands in W2), so
///     there is deliberately no foreign key — W2 must not add one here
///     retroactively unless it also ships the compound user-reference pattern
///     documented in README.
///   - Row-level security, fail-closed: a connection that has not set the
///     transaction-local `app.user_id` GUC sees ZERO rows, ever.
///     `kal_platform` has explicit per-table exemption policies (SELECT/DELETE
///     only) for the enumerated cross-user job shapes (ADR-0002 §3).
model WeightLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable consumer user id (I1 — per-plane id: consumers `user_id`).
  /// Never exposed as an authorization control by clients — the user binding
  /// is re-verified server-side (I6).
  userId String @map("user_id") @db.Uuid

  /// When the weigh-in happened (user's measurement instant, UTC).
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)

  /// Body weight in kilograms, two-decimal precision (PRD §21 "Weight log":
  /// timestamped weight entries per user, input to trend smoothing).
  weightKg Decimal @map("weight_kg") @db.Decimal(5, 2)

  @@index([userId, recordedAt])
  @@map("weight_log")
}

// ---------------------------------------------------------------------------
// Identity (Wave 2 — lane w02-s1-schema; contract: docs/api/wave-02-contract.md)
// ---------------------------------------------------------------------------

/// Consumer account anchor (ARCHITECTURE §10/D-06, PRD §8). One row per
/// consumer identity. Not a consumer-health table — deliberately outside RLS
/// scope (ADR-0002 §1; the per-table adopt/decline decision for every W2
/// identity table is documented in docs/api/wave-02-contract.md §5 and the
/// README "Roles & row-level security" section).
///
/// Identifiers: all three sign-in identifiers are collected at signup (D-06)
/// and are UNIQUE at the database layer — enumeration resistance is an
/// application-layer observable (the signup duplicate path returns a generic
/// success; see the contract note §3), while uniqueness itself is structural.
/// Stored values are canonicalized by the application (email/username lower-
/// cased, phone E.164); the CHECK constraints pin the canonical shapes.
///
/// password_hash is a PHC string (argon2id per ADR-0003) — never decoded,
/// never returned by any endpoint, never logged. It is NULL only for the
/// DEFERRED social-login path (Apple/Google — no such accounts exist in W2;
/// reserved seam per the contract note §4).
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Canonical lowercase email. Globally unique (structural uniqueness, I3).
  email String @unique @db.Text

  /// Canonical lowercase username, globally unique (PRD §8/D-06). Format
  /// pinned by CHECK `users_username_format` in the identity migration.
  username String @unique @db.Text

  /// Canonical E.164 phone. Nullable: W2 signup always provides it (D-06);
  /// NULL is reserved for the deferred social-login path, where the platform
  /// may not disclose a phone number. Unique where present (PostgreSQL allows
  /// multiple NULLs in a unique index).
  phone String? @unique @db.Text

  /// Salted adaptive hash (PHC string, argon2id — ADR-0003). NULL reserved
  /// for the deferred social-login path only. Never exposed, never logged.
  passwordHash String? @map("password_hash") @db.Text

  /// Account lifecycle state (PRD §17). W2 only ever writes 'active'; the
  /// closure states are reserved structurally for the W6 lifecycle module.
  /// Sign-in refuses non-active accounts with the generic UNAUTHENTICATED
  /// observable (contract note §3 — closure never becomes an oracle).
  status String @default("active") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Touched on credential changes (rehash-on-login). Column-level UPDATE
  /// grants cover password_hash and updated_at only — identity columns are
  /// immutable (I1).
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  recoveryTickets RecoveryTicket[]

  @@map("users")
}

/// One row per signed-in session ("signed-in device", PRD §8/FR-007). Owned
/// child of users (I1/I3): immutable user_id FK, no UPDATE grant on the id or
/// user_id columns. The access JWT carries sid = this row's id; the refresh
/// token is an opaque secret whose SHA-256 hash lives on the row and ROTATES
/// on every use (rotation generation counter detects reuse ⇒ chain revocation
/// — contract note §1). Not a health table — RLS declined (contract note §5);
/// isolation via the identity module's mandatory user-scoped predicates.
model Session {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (per-plane id: consumers user_id, I1).
  userId String @map("user_id") @db.Uuid

  /// Optional client-chosen display label for "signed-in devices" lists
  /// (≤ 64 chars, CHECK-pinned). Never a device fingerprint: the abuse-
  /// throttle device key is a digested X-Device-Id header value that is
  /// never stored on sessions (contract note §2).
  deviceLabel String? @map("device_label") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Absolute session expiry (no sliding window — contract note §1).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Set on explicit revocation or refresh-chain-reuse revocation.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// SHA-256 hex of the current opaque refresh token (rotates on use).
  refreshTokenHash String @map("refresh_token_hash") @unique @db.Text

  /// Increments on every refresh rotation; presenting a superseded
  /// generation revokes the chain (contract note §1).
  refreshGeneration Int @default(0) @map("refresh_generation") @db.Integer

  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  /// Sessions-list ordering key (contract note §2: createdAt DESC, id DESC —
  /// deterministic, reproducible pagination).
  @@index([userId, createdAt(sort: Desc)])
  @@map("sessions")
}

/// Single-use, bounded-TTL account-recovery ticket (PRD §8 recovery journeys;
/// FR-003). The ticket secret is issued once via the MailPort seam and only
/// its SHA-256 hash is stored; completion consumes the ticket transactionally
/// and invalidates ALL of the account's sessions. A new request invalidates
/// prior outstanding tickets (single live ticket per account — contract note
/// §2). Owned child of users (I1/I3). RLS declined (contract note §5).
model RecoveryTicket {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Immutable owning-consumer id (I1).
  userId String @map("user_id") @db.Uuid

  /// SHA-256 hex of the single-use ticket secret — never the secret itself.
  tokenHash String @map("token_hash") @unique @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Bounded TTL (config point, contract note §6); expiry is a generic
  /// failure observable identical to wrong/used tickets.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  /// Set transactionally at completion (single use). Expired tickets are
  /// cleaned up by the platform housekeeping shape (enumerated grant).
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("recovery_tickets")
}

/// Platform-owned credential-attempt throttle state (PRD §8 abuse prevention;
/// ARCHITECTURE §11 places rate-limit counters on the platform plane). Keyed
/// by DIGESTS of the submitted identifier and the device identifier — never
/// by user_id (counters must tick for unknown identifiers too, so the lockout
/// observable cannot become an existence oracle; contract note §3). Not
/// user-owned data at all — outside RLS scope entirely (declined, contract
/// note §5).
model AuthAttemptCounter {
  /// Server-keyed digest of the canonicalized submitted identifier.
  subjectKey String @map("subject_key") @db.Text

  /// Server-keyed digest of the client X-Device-Id header value.
  deviceKey String @map("device_key") @db.Text

  failedCount Int @default(0) @map("failed_count") @db.Integer

  firstFailedAt DateTime @default(now()) @map("first_failed_at") @db.Timestamptz(6)
  lastFailedAt DateTime @default(now()) @map("last_failed_at") @db.Timestamptz(6)

  /// Set while the (identifier, device) pair is locked; NULL otherwise.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  @@id([subjectKey, deviceKey])
  @@map("auth_attempt_counters")
}

// ---------------------------------------------------------------------------
// Phase 1 domain sections — RESERVED (tables land with their wave; do not
// build early). Order follows ARCHITECTURE §9 module map / PLAN.md §4.
// ---------------------------------------------------------------------------

// consent    (W5)  — per-purpose consent records with grant/withdrawal history
// tracking   (W3)  — foods, serving variants, diary entries (frozen nutrient
//                    snapshots, I11), diary days
// journal    (W4)  — exercise catalog, workout sessions, routines, PRs
// goals      (W5)  — goal setup, versioned target profiles/snapshots,
//                    trend/streak inputs (weight_log above is its health table;
//                    its retroactive user_id FK decision is documented in
//                    docs/api/wave-02-contract.md §5 — deferred to W3)
// community  (W6)  — UGC meal-prep/recipe posts, engagement, moderation states
// content    (W7)  — Kal-curated meal ideas, review workflow, revisions
// sync       (W3)  — client-op ledger (dedupe on user + client op ID),
//                    per-user opaque cursors, tombstones
// lifecycle  (W6)  — export/deletion jobs, retention-exception records
// notifications (W5) — per-purpose dispatch records, idempotency keys
// analytics  (later W) — frozen-metric event tables (no health data, I12)
// admin      (W6)  — privileged-plane queue/grant records (audit_events above
//                    is its log; the plane itself is W6+)

// ---------------------------------------------------------------------------
// Phase 2 / Phase 3 — RESERVED BOUNDARIES ONLY (ARCHITECTURE §23).
// No tables, no columns, no seeds for these phases before their gate.
// ---------------------------------------------------------------------------

// premium   (Phase 2) — entitlement-hook seam only until HD-30 gates the build
// catalog   (Phase 3) — vendor menu items, availability TTL (HD-33 for links)
// matching  (Phase 3) — macro-match config (HD-13 gates the engine)
// ordering  (Phase 3) — canonical order state machine, zones (C-1 gates dispatch)
// payments  (Phase 3) — PSP ledger; blocked on HD-04/HD-05
// delivery  (Phase 3) — per-vendor exclusive election (D-08); HD-08 couriers
// vendor    (Phase 3) — branch onboarding/KYB, one account per branch
// settlement (Phase 3) — weekly cycle, statements, COD netting per HD-06
