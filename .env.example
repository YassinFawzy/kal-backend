# Kal backend — local development environment.
# Copy to .env and adjust. NEVER commit .env (real credentials live only there).
#
# Boot-time validation (I15): the process refuses to start when DATABASE_URL
# is missing/malformed or carries an empty or placeholder-class password
# ("changeme"/"TODO"-class values). The values below are SHAPE examples, not
# working credentials — copying this file verbatim refuses the boot by design.
#
# Local dev database: an empty `kal` database on the machine's local PostgreSQL.
# Schema reaches it ONLY through reviewed migrations (see README "Database
# migrations") — never `prisma db push`.
#
# Connection-role convention (README "Roles & row-level security"):
# DATABASE_URL connects as your admin/migration user (it runs migrations and
# may create the cluster-level roles). Request-scope data access runs as the
# NOLOGIN role `kal_app` via `SET ROLE` per transaction — not via this URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kal?schema=public"

# Node environment: development | production | test (default: development).
NODE_ENV="development"

# HTTP port (integer 1–65535; default: 3000).
PORT="3000"

# ---------------------------------------------------------------------------
# Identity (wave-02 contract note §6 — values are PRD §8 initial values,
# HD-23-tunable; every key below is OPTIONAL and falls back to the contract
# default; production REQUIRES the signing key).
# ---------------------------------------------------------------------------

# HMAC-SHA256 key material for access tokens (≥ 32 chars, placeholder-class
# values refuse the boot). REQUIRED in production; in development/test an
# ephemeral per-boot key is generated when omitted (dev convenience only).
# IDENTITY_JWT_SIGNING_KEY=""

# Access-token lifetime, seconds (default 900).
# IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900

# Absolute session lifetime, seconds (default 2592000 = 30 days).
# IDENTITY_SESSION_TTL_SECONDS=2592000

# Hard upper bound on session-state caching, seconds (default 60).
# IDENTITY_REVOCATION_WINDOW_SECONDS=60

# Failed attempts before (identifier, device) lockout (default 3 — PRD §8).
# IDENTITY_LOCKOUT_THRESHOLD_ATTEMPTS=3

# Lockout duration in seconds; the Retry-After basis (default 900).
# IDENTITY_LOCKOUT_DURATION_SECONDS=900

# Single-use recovery-ticket TTL, seconds (default 1800; consumed by the
# recovery lane).
# IDENTITY_RECOVERY_TICKET_TTL_SECONDS=1800

# argon2id parameters (ADR-0003 defaults; ADR: tunable via validated config).
# IDENTITY_ARGON2_MEMORY_KIB=65536
# IDENTITY_ARGON2_TIME_COST=3
# IDENTITY_ARGON2_PARALLELISM=1

# CORS — comma-separated browser origins allowed to call the API (Expo web dev defaults; set to production web origins at deployment)
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Tracking rate limits (wave-03 s2a; config points — contract note §6)
# TRACKING_USER_FOOD_CREATE_MAX_PER_HOUR=20
# TRACKING_USER_FOOD_CREATE_MAX_PER_DAY=100

# --- sync (wave-03 ingestion; contract §6 — HD-23-tunable) -------------------

# Max ops per ingestion batch; over-limit ⇒ whole-batch 400 (default 100).
# SYNC_MAX_OPS_PER_BATCH=100

# Idempotency-Key retention, seconds (default 2592000 = 30 days; min 3600).
# SYNC_IDEMPOTENCY_KEY_RETENTION_SECONDS=2592000
